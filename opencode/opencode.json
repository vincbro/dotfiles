{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"openrouter": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "OpenRouter",
			"options": {
				"baseURL": "https://openrouter.ai/api/v1",
				"apiKey": "{env:OR_KEY}"
			}
		}
	},
	"agent": {
		"build": {
			"disable": true
		},
		"plan": {
			"disable": true
		}
	},
	"default_agent": "planner"
}