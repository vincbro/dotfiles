{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"openrouter": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "OpenRouter",
			"options": {
				"baseURL": "https://openrouter.ai/api/v1",
				"apiKey": "{env:OR_KEY}"
			}
		}
	},
	"agent": {
		"build": {
			"model": "zai-coding-plan/glm-4.5-air",
			"color": "#22dd5c"
		},
		"plan": {
			"model": "zai-coding-plan/glm-5.2",
			"color": "#ec1332"
		}
	},
	"default_agent": "planner"
}
